<ui:UXML editor-extension-mode="False" uss="L2StyleSheet" uss="ShopStyle" xmlns:ui="UnityEngine.UIElements">
  <ui:Instance template="WindowTemplate" template="WindowTemplate" name="WindowTemplate" class="shop-window">
    <ui:VisualElement name="Content" class="shop-window-content-container">
      <ui:VisualElement name="InventoryContent" class="shop-item-container">
        <ui:Instance template="L2TabView" template="L2TabView" name="ShopTabView" />
        <ui:VisualElement name="ButtonBar" class="shop-button-bar">
          <ui:Instance template="L2Button" template="L2Button" name="BuyButton" class="shop-button" />
          <ui:Instance template="L2Button" template="L2Button" name="CancelButton" class="shop-button" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:Instance>
</ui:UXML>