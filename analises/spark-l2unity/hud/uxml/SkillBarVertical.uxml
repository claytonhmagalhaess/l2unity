<ui:UXML editor-extension-mode="False" uss="L2StyleSheet" uss="SkillbarWindow" xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="SkillBar1" class="skillbar skillbar-vertical">
    <ui:VisualElement name="Wrapper" class="skillbar-wrapper skillbar-wrapper-vertical">
      <ui:VisualElement name="DragArea" class="skillbar-drag skillbar-drag-vertical">
        <ui:GroupBox name="Frame_DF_Ver" class="frame_df_ver frame_df_ver-vertical">
          <ui:VisualElement />
          <ui:VisualElement name="VisualElement" />
          <ui:VisualElement name="VisualElement" />
          <ui:VisualElement name="VisualElement" />
        </ui:GroupBox>
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="ExpandBtn" class="skillbar-footer-btn button-expand button-expand-vertical" />
        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="MinimizeBtn" class="skillbar-footer-btn button-minimize button-minimize-vertical" />
      </ui:VisualElement>
      <ui:VisualElement name="InnerContainer" class="skillbar-inner-container skillbar-inner-container-vertical">
        <ui:VisualElement name="NumberGroupBox" class="skillbar-arrow-control skillbar-arrow-control-vertical">
          <ui:VisualElement name="SkillArrowInputVertical" class="skill-arrow-input skill-arrow-input-vertical">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="RightArrow" class="skillbar-footer-btn skillbar-arrow-input-right" />
            <ui:TextField picking-mode="Ignore" focusable="false" readonly="true" name="L2Input" value="1" class="skill-arrow-input-label" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="LeftArrow" class="skillbar-footer-btn skillbar-arrow-input-left" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SlotContainer" class="skillbar-slot-container skillbar-slot-container-vertical">
          <ui:VisualElement name="Darkener" class="skillbar-darkener skillbar-darkener-vertical" />
          <ui:VisualElement name="SlotAnchor1" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor2" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor3" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor4" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="Spacer" class="skillbar-slot-spacer" />
          <ui:VisualElement name="SlotAnchor5" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor6" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor7" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor8" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="Spacer" class="skillbar-slot-spacer" />
          <ui:VisualElement name="SlotAnchor9" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor10" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor11" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
          <ui:VisualElement name="SlotAnchor12" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
            <ui:Instance template="Slot" template="Slot" name="Slot" />
          </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FooterContainer" class="footer-container-vertical">
          <ui:VisualElement name="Footer" class="skillbar-footer skillbar-footer-vertical">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="TooltipBtn" class="skillbar-footer-btn button-tooltip" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="RotateBtn" class="skillbar-footer-btn button-rotate" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="LockBtn" class="skillbar-footer-btn button-lock" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>