<ui:UXML editor-extension-mode="False" uss="L2StyleSheet" uss="L2Button" uss="SkillWindow" xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="SkillsSection" class="skills-section-container">
    <ui:VisualElement name="SkillsSectionHeader" class="skills-section-header">
      <ui:Button name="PlusMinusBtn" class="l2-plus-minus-button" />
      <ui:Label name="SkillsSectionHeaderLabel" text="Physical Skills" class="l2-color-3" />
    </ui:VisualElement>
    <ui:VisualElement name="SkillsSectionBarContainer" class="skills-bar-container">
      <ui:Instance template="L2SlotContainer" template="L2SlotContainer" name="SkillSectionInner" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>