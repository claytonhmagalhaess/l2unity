      <ui:GroupBox name="GroupBoxRow6" class="border_row5">
        <ui:GroupBox name="GroupBoxImageRow6">
          <ui:VisualElement name="Skill_Icon6" class="row5" />
        </ui:GroupBox>
      </ui:GroupBox>
      <ui:GroupBox name="GroupBoxRow7" class="border_row6">
        <ui:GroupBox name="GroupBoxImageRow7">
          <ui:VisualElement name="Skill_Icon7" class="row6" />
        </ui:GroupBox>
      </ui:GroupBox>
      <ui:GroupBox name="GroupBoxRow8" class="border_row7">
        <ui:GroupBox name="GroupBoxImageRow8">
          <ui:VisualElement name="Skill_Icon8" class="row7" />
