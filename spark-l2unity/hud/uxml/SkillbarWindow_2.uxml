<ui:UXML editor-extension-mode="False" uss="L2StyleSheet" xmlns:ui="UnityEngine.UIElements">
  <ui:GroupBox name="ShortCut" class="short-cut">
    <ui:GroupBox name="GroupBox" class="drag-area-shortcut">
      <ui:GroupBox name="GroupBox">
        <ui:VisualElement />
      </ui:GroupBox>
      <ui:GroupBox>
        <ui:VisualElement name="head-slider" class="button-slider" />
      </ui:GroupBox>
      <ui:GroupBox>
        <ui:VisualElement />
      </ui:GroupBox>
      <ui:GroupBox name="GroupBox">
        <ui:VisualElement />
      </ui:GroupBox>
      <ui:GroupBox name="horizontal-groupbox">
        <ui:VisualElement name="head-slide-hor" class="slide-hor" />
      </ui:GroupBox>
      <ui:GroupBox>
        <ui:VisualElement />
      </ui:GroupBox>
    </ui:GroupBox>
    <ui:GroupBox>
      <ui:GroupBox name="GroupBoxButon">
        <ui:Button parse-escape-sequences="false" display-tooltip-when-elided="false" name="button_preview" class="button-option_preview" />
      </ui:GroupBox>
      <ui:GroupBox>
        <ui:VisualElement name="ImageIndexPanel" class="ImageIndex" />
      </ui:GroupBox>
      <ui:GroupBox>
        <ui:Button parse-escape-sequences="false" display-tooltip-when-elided="false" enable-rich-text="true" focusable="true" name="button_next" class="button-option_next" />
      </ui:GroupBox>
    </ui:GroupBox>
    <ui:GroupBox name="GroupBox">
      <ui:GroupBox name="GroupBoxRow1" class="border_row0">
