<ui:UXML editor-extension-mode="False" uss="L2StyleSheet" uss="TargetWindow" xmlns:ui="UnityEngine.UIElements">
  <ui:GroupBox name="TargetWindow" class="target-window">
    <ui:Instance template="Frame_DF_Ver" template="Frame_DF_Ver" name="TemplateContainer" class="target-window-drag drag-area" />
    <ui:GroupBox name="CenterContainer" class="ui-bg ui-border target-window-bg">
      <ui:VisualElement class="target-window-inner">
        <ui:Label text="Label" name="TargetName" class="target-window-target-name l2-color-4" />
        <ui:VisualElement class="target-window-bar-container">
          <ui:Instance template="L2Bar" template="L2Bar" name="HPBar" class="target-bar-container" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:GroupBox>
    <ui:VisualElement name="SizeControl" class="target-window-size-control">
      <ui:VisualElement name="SizeControl" class="target-window-resize-handle resize-hor" />
    </ui:VisualElement>
    <ui:Button text="
" name="CloseBtn" class="close-btn target-window-close-btn" />
  </ui:GroupBox>
</ui:UXML>